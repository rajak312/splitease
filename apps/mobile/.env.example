# GraphQL endpoint. Leave unset in development: the app uses http://localhost:4600/graphql
# on web and your computer's LAN IP (from the Expo dev server) inside Expo Go.
# EXPO_PUBLIC_API_URL=https://splitease-api-lalit.vercel.app/graphql

# "sse" = GraphQL subscriptions over Server-Sent Events (local API)
# "poll" = refetch every 15 s (default automatically when the API URL is https://, i.e. Vercel)
# EXPO_PUBLIC_REALTIME=sse

# Public URL of the web app (used for links)
# EXPO_PUBLIC_WEB_URL=https://splitease-lalit.vercel.app
