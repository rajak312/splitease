# Local development (docker compose up -d postgres)
DATABASE_URL="postgresql://splitease:splitease@localhost:5436/splitease?schema=public"
# Used by the Prisma CLI for migrations. On Neon use the *direct* (non-pooled) URL.
DIRECT_URL="postgresql://splitease:splitease@localhost:5436/splitease?schema=public"

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="change-me-access-secret-at-least-32-characters"
JWT_REFRESH_SECRET="change-me-refresh-secret-at-least-32-characters"

# Comma-separated list of allowed browser origins
CORS_ORIGINS="http://localhost:8081,http://localhost:3600"

PORT=4600
